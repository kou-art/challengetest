          "alarmStatus",
          "controlState",
          "eqpName",
          "equipmentStatus"
        ],
        "type": "object",
        "properties": {
          "eqpName": {
            "minLength": 1,
            "type": "string"
          },
          "controlState": {
            "type": "integer",
            "format": "int32"
          },
          "equipmentStatus": {
            "type": "integer",
            "format": "int32"
          },
          "alarmStatus": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "InsertCommand": {
        "required": [
          "carrierId",
          "commandType",
          "eqpName"
        ],
        "type": "object",
        "properties": {
          "commandType": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "carrierId": {
            "minLength": 1,
            "type": "string"
          },
          "eqpName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RelayCommand": {
        "required": [
          "eqpName"
        ],
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "nullable": true
          },
          "carrierId": {
            "type": "string",
            "nullable": true
          },
          "eqpName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
