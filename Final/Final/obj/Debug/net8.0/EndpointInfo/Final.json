  "components": {
    "schemas": {
      "EquipmentCommand": {
        "required": [
          "carrierId",
          "commandId",
          "commandStatus",
          "commandType",
          "eqpName",
          "location"
        ],
        "type": "object",
        "properties": {
          "commandId": {
            "minLength": 1,
            "type": "string"
          },
          "commandType": {
            "type": "integer",
            "format": "int32"
          },
          "carrierId": {
            "minLength": 1,
            "type": "string"
          },
          "eqpName": {
            "minLength": 1,
            "type": "string"
          },
